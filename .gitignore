.venv/
.venv-check/
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store

# 사용자 제공 압축 원본은 카탈로그로 공유한다.
data/*.zip

# 원본 데이터는 커밋하지 않는다 (용량·라이선스). 카탈로그의 URL로 재현한다.
# 단 폴더 구조는 남긴다 — 디렉토리를 먼저 되살려야 .gitkeep 예외가 먹는다.
# (git 은 부모 디렉토리가 제외되면 그 안의 파일을 다시 포함시킬 수 없다)
data/raw/**
data/interim/**
!data/raw/**/
!data/interim/**/
!data/**/.gitkeep

# 머신별 개인 설정 (절대경로 등) — 공유하지 않는다
.claude/settings.local.json

# 행 단위 전처리·루트 중복 원본도 공개하지 않는다. 공개 집계는 web/final에 둔다.
data/**
!data/**/
!data/**/.gitkeep

# 에이전트 실행 상태는 로컬 보존. 명시적인 공유 스킬만 예외로 둔다.
.omc/*
!.omc/skills/
